{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r4b1t-runtime-corpus-shadow-v1.schema.json",
  "title": "R4B1T Runtime Corpus Shadow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus",
    "ruleset",
    "provenanceArtifactDigest",
    "eligibilityInputDigest",
    "eligibilityOutputDigest",
    "urlPoolDigest",
    "count",
    "records"
  ],
  "properties": {
    "schema": {"const": "r4b1t-runtime-corpus-shadow-v1"},
    "corpus": {"type": "string", "minLength": 1},
    "ruleset": {"const": "eligibility-v1"},
    "provenanceArtifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eligibilityInputDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eligibilityOutputDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "urlPoolDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "count": {"type": "integer", "minimum": 0},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "resource_type", "source"],
        "properties": {
          "url": {"type": "string", "minLength": 1},
          "resource_type": {"type": "string", "minLength": 1},
          "source": {
            "type": "string",
            "pattern": "^provenance:sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
