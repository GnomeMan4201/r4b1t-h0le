{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r4b1t-corpus-provenance-v1.schema.json",
  "title": "R4B1T Corpus Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus",
    "sources",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "r4b1t-corpus-provenance-v1"
    },
    "corpus": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "curated_catalog",
            "manual_review",
            "publisher_assertion"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "resourceType": {
      "enum": [
        "repository",
        "source_file",
        "security_tool",
        "documentation",
        "article",
        "writeup",
        "research",
        "paper",
        "advisory",
        "vulnerability_record",
        "software_release",
        "dataset",
        "threat_feed",
        "rule_collection",
        "corpus",
        "lab",
        "challenge",
        "training_resource",
        "reference",
        "other_explicit"
      ]
    },
    "sourceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_id"
      ],
      "properties": {
        "kind": {
          "const": "source_assertion"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "structuralBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rule_id"
      ],
      "properties": {
        "kind": {
          "const": "structural_rule"
        },
        "rule_id": {
          "enum": [
            "github-repository-v1",
            "github-wiki-v1",
            "github-release-v1"
          ]
        }
      }
    },
    "resourceTypeClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "basis"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/resourceType"
        },
        "basis": {
          "oneOf": [
            {
              "$ref": "#/$defs/sourceBasis"
            },
            {
              "$ref": "#/$defs/structuralBasis"
            }
          ]
        }
      }
    },
    "scopeAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "source_id"
      ],
      "properties": {
        "scope": {
          "const": "cybersecurity"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "resource_type",
        "scope_assertions"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "resource_type": {
          "$ref": "#/$defs/resourceTypeClaim"
        },
        "scope_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scopeAssertion"
          }
        }
      }
    }
  }
}
