{
  "schema": "r4b1t-resource-classification/v2",
  "version": "resource-classification-v2.0",
  "status": "frozen",
  "notes": "FROZEN classification authority for WILD intake. FORM (resource_type: what the thing is) is separated from TOPIC (subjects: what it is about), fixing the v1 collision where security_tool / threat_feed / advisory encode both. Rules are fail-closed: unknown or missing rule keys are invalid. primary_subject_in_subjects=true means subjects must contain primary_subject; max_subjects counts the full list including it. Any semantic change requires a new version and a new authority digest.",
  "rules": {
    "max_subjects": 4,
    "min_reason_chars": 20,
    "subjects_delimiter": "|",
    "primary_subject_in_subjects": true
  },
  "resource_types": [
    {
      "id": "interactive_tool",
      "description": "single-purpose utility used in the browser: converter, calculator, encoder, generator, analyzer"
    },
    {
      "id": "simulation",
      "description": "model of a system you can run or perturb"
    },
    {
      "id": "visualization",
      "description": "explorable view of data or a concept, not primarily a map"
    },
    {
      "id": "map",
      "description": "geographic or spatial explorer (cables, transmitters, fires, history, language)"
    },
    {
      "id": "experiment",
      "description": "browser toy, creative-coding piece, one-off oddity; exists to be played with"
    },
    {
      "id": "instrument",
